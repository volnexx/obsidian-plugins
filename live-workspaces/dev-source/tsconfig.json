{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": { "*": ["node_modules/*"] },
    "typeRoots": ["node_modules/@types"],
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["DOM", "ES2022"],
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "moduleResolution": "node"
  },
  "include": ["src/**/*.ts"]
}
